# A more formal description of this format can be found here:
# https://github.com/hybrid-cloud-patterns/common/tree/main/ansible/roles/vault_utils#values-secret-file-format

version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

secrets:
  - name: mysql-credentials
    vaultPrefixes:
    - global
    fields:
    - name: rootpasswd
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
  # S4 Web UI login (merged into Kubernetes Secret s4-credentials by vp-s4-storage)
  - name: s4-ui-credentials
    vaultPrefixes:
    - global
    fields:
    - name: UI_USERNAME
      value: s4admin
      onMissingValue: error
    - name: UI_PASSWORD
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
  # S4 S3 API credentials (used by TempoStack object storage and S4 itself)
  - name: s4-api-credentials
    vaultPrefixes:
    - global
    fields:
    - name: AWS_ACCESS_KEY_ID
      value: s4admin
      onMissingValue: error
    - name: AWS_SECRET_ACCESS_KEY
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
